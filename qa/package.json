{
  "name": "lifeos-qa",
  "private": true,
  "description": "Regression guards for LifeOS.html (dev-only; the app itself stays dependency-free).",
  "type": "module",
  "scripts": {
    "fingerprint": "node fingerprint.mjs --check",
    "fingerprint:update": "node fingerprint.mjs --write",
    "smoke": "node smoke.mjs",
    "screens": "node smoke.mjs --screens",
    "test": "node fingerprint.mjs --check && node smoke.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "playwright": "1.56.1"
  }
}
